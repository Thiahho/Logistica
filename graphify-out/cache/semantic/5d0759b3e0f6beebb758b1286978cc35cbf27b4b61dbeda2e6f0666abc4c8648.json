{"nodes": [{"id": "docs_auditoria_seguridad_rate_limiting_login", "label": "Hallazgo Alto 1 \u2014 Sin rate limiting en /api/auth/login (RESUELTO)", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Alto 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin l\u00edmite de intentos era fuerza bruta viable; resuelto con FixedWindowRateLimiter, 5/min, particionado por IP para no permitir bloquear la cuenta de otro."}, {"id": "docs_auditoria_seguridad_password_texto_plano", "label": "Hallazgo Alto 2 \u2014 Contrase\u00f1a de Postgres en texto plano en appsettings.Development.json", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Alto 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Riesgo bajo mientras sea solo DB local, pero h\u00e1bito a cortar; ya usan dotnet user-secrets para Jwt:Key. Pendiente."}, {"id": "docs_auditoria_seguridad_validacion_formato_campos", "label": "Hallazgo Medio 3 \u2014 Sin validaci\u00f3n de formato en Email/Cuit/Telefono", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Medio 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No es vulnerabilidad (EF parametriza todo) pero permite datos basura silenciosos. Pendiente."}, {"id": "docs_auditoria_seguridad_politica_password_debil", "label": "Hallazgo Medio 4 \u2014 Pol\u00edtica de contrase\u00f1a m\u00ednima d\u00e9bil (8 caracteres)", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Medio 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aceptable para el estadio actual (cuentas creadas solo por admin, no self-signup). Pendiente."}, {"id": "docs_auditoria_seguridad_borrador_confirmado_fix", "label": "Correcci\u00f3n \u2014 Borrador\u2192Confirmado ya no era transici\u00f3n manual v\u00e1lida", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Corregido durante la sesi\u00f3n", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permit\u00eda confirmar y rutear un pedido con precio null, violando la regla de que el precio se fija solo al cerrar planificaci\u00f3n."}, {"id": "docs_auditoria_seguridad_almacenamiento_fotos", "label": "Fortaleza \u2014 Manejo de archivos (AlmacenamientoFotos.cs)", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Fortalezas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Valida GUID real del deviceUuid (previene path traversal), tama\u00f1o m\u00e1ximo y magic-byte real del JPEG."}, {"id": "docs_auditoria_seguridad_sql_sin_injection", "label": "Fortaleza \u2014 SQL sin superficie de injection", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Fortalezas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SqlQuery/ExecuteSqlInterpolatedAsync usan interpolaci\u00f3n parametrizada por EF, nunca concatenaci\u00f3n de strings."}, {"id": "docs_auditoria_seguridad_idor_cubierto", "label": "Fortaleza \u2014 IDOR bien cubierto", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Fortalezas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PedidosController.Detalle filtra por clienteId del claim; MisParadasController filtra por Ruta.RepartidorId."}, {"id": "docs_auditoria_seguridad_jwt_cookies", "label": "Fortaleza \u2014 JWT/cookies bien configurados", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Fortalezas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clave de firma solo por user-secrets/env var, validaciones issuer/audience/lifetime, cookie de refresh HttpOnly+SameSite=Strict+Secure, CORS con origen \u00fanico."}, {"id": "docs_auditoria_seguridad_manejo_excepciones", "label": "Fortaleza \u2014 Manejo de excepciones sin fugas", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Fortalezas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ning\u00fan 500 filtra stack trace, ni siquiera en desarrollo."}, {"id": "docs_auditoria_seguridad_frontend_sin_xss", "label": "Fortaleza \u2014 Frontend sin superficie de XSS", "file_type": "concept", "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Fortalezas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin dangerouslySetInnerHTML en c\u00f3digo propio; React escapa por defecto."}], "edges": [{"source": "docs_auditoria_seguridad_rate_limiting_login", "target": "docs_construccion_v1_changelog_116", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Alto 1", "weight": 1.0}, {"source": "docs_auditoria_seguridad_rate_limiting_login", "target": "docs_construccion_v1_programcs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Alto 1", "weight": 1.0}, {"source": "docs_auditoria_seguridad_borrador_confirmado_fix", "target": "docs_construccion_v1_changelog_115", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/auditoria_seguridad.md", "source_location": "\u00a7Corregido durante la sesi\u00f3n", "weight": 1.0}, {"source": "docs_auditoria_seguridad_borrador_confirmado_fix", "target": "docs_acta_sistema_v3_changelog_311", "relation": "cites", "confidence": "EXTRACTE